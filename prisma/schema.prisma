generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id                    String    @id @default(uuid())
  name                  String
  phone                 String
  address               String
  adminName             String
  status                String    @default("ACTIVE") // ACTIVE, TRIAL, BLOCKED, DELETED
  trialStartDate        DateTime?
  trialEndDate          DateTime?
  subscriptionType      String?   @default("TRIAL") // TRIAL, MONTHLY
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?
  taxRate               Float     @default(0)
  taxIncluded           Boolean   @default(false)
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  users                 User[]
  subscriptions         Subscription[]
  products              Product[]
  categories            Category[]
  manufacturers         Manufacturer[]
  suppliers             Supplier[]
  batches               ProductBatch[]
  inventoryTransactions InventoryTransaction[]
  sales                 Sale[]
  customers             Customer[]
  debts                 Debt[]
  returns               Return[]
  notifications         Notification[]
  auditLogs             AuditLog[]

  @@index([status])
}

model User {
  id           String   @id @default(uuid())
  shopId       String?
  role         String // SUPER_ADMIN, SHOP_ADMIN, WAREHOUSEMAN, CASHIER
  fullName     String
  username     String   @unique
  passwordHash String
  phone        String?
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE, BLOCKED
  permissions  String? // JSON array or comma separated
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shop         Shop?                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sales        Sale[]
  transactions InventoryTransaction[]
  returns      Return[]
  auditLogs    AuditLog[]

  @@index([shopId])
  @@index([role])
}

model Subscription {
  id            String   @id @default(uuid())
  shopId        String
  planName      String   @default("Oylik obuna (30 kun)")
  durationDays  Int      @default(30)
  startDate     DateTime
  endDate       DateTime
  price         Float    @default(0)
  status        String   @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  activatedBy   String?
  paymentMethod String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model Category {
  id          String   @id @default(uuid())
  shopId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([shopId, name])
  @@index([shopId])
}

model Manufacturer {
  id        String   @id @default(uuid())
  shopId    String
  name      String
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([shopId, name])
  @@index([shopId])
}

model Product {
  id             String   @id @default(uuid())
  shopId         String
  name           String
  barcode        String?
  qrCode         String?
  categoryId     String?
  manufacturerId String?
  salePrice      Float    @default(0)
  minStock       Int      @default(5)
  unit           String   @default("dona")
  description    String?
  status         String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop         Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category     Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  manufacturer Manufacturer?          @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  batches      ProductBatch[]
  saleItems    SaleItem[]
  returnItems  ReturnItem[]
  transactions InventoryTransaction[]

  @@index([shopId])
  @@index([barcode])
  @@index([qrCode])
}

model Supplier {
  id             String   @id @default(uuid())
  shopId         String
  name           String
  phone          String?
  address        String?
  contactPerson  String?
  totalPurchases Float    @default(0)
  totalPaid      Float    @default(0)
  debt           Float    @default(0)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop    Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  batches ProductBatch[]

  @@index([shopId])
}

model ProductBatch {
  id              String   @id @default(uuid())
  shopId          String
  productId       String
  batchNumber     String
  initialQuantity Int      @default(0)
  currentQuantity Int      @default(0)
  purchasePrice   Float    @default(0)
  salePrice       Float    @default(0)
  receivedDate    DateTime @default(now())
  expiryDate      DateTime
  supplierId      String?
  status          String   @default("NORMAL") // NORMAL, APPROACHING, EXPIRED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop         Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier     Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  saleItems    SaleItem[]
  returnItems  ReturnItem[]
  transactions InventoryTransaction[]

  @@index([shopId])
  @@index([productId])
  @@index([expiryDate])
  @@index([shopId, batchNumber])
}

model InventoryTransaction {
  id          String   @id @default(uuid())
  shopId      String
  productId   String
  batchId     String?
  type        String // INFLOW, OUTFLOW_SALE, OUTFLOW_RETURN, ADJUSTMENT
  quantity    Int
  unitPrice   Float    @default(0)
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())

  shop      Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch     ProductBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([productId])
}

model Customer {
  id             String   @id @default(uuid())
  shopId         String
  name           String
  phone          String?
  totalSpent     Float    @default(0)
  purchasesCount Int      @default(0)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop  Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sales Sale[]

  @@index([shopId])
  @@index([phone])
}

model Debt {
  id          String   @id @default(uuid())
  shopId      String
  firstName   String
  lastName    String
  phone       String?
  amount      Float    @default(0)
  description String?
  status      String   @default("OPEN") // OPEN, PAID, CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([status])
}

model Sale {
  id             String   @id @default(uuid())
  shopId         String
  receiptNumber  String   @unique
  idempotencyKey String?  @unique
  cashierId      String
  customerId     String?
  totalAmount    Float    @default(0)
  discountAmount Float    @default(0)
  taxRate        Float    @default(0)
  taxAmount      Float    @default(0)
  payableAmount  Float    @default(0)
  paidAmount     Float    @default(0)
  changeAmount   Float    @default(0)
  paymentMethod  String   @default("CASH") // CASH, CARD, ELECTRONIC, DEBT (qarzga sotuv)
  status         String   @default("COMPLETED") // COMPLETED, CANCELLED, REFUNDED
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop     Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cashier  User       @relation(fields: [cashierId], references: [id])
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    SaleItem[]
  payments Payment[]
  returns  Return[]

  @@index([shopId])
  @@index([cashierId])
  @@index([receiptNumber])
  @@index([createdAt])
}

model SaleItem {
  id            String   @id @default(uuid())
  saleId        String
  productId     String
  batchId       String
  quantity      Int
  unitPrice     Float
  discount      Float    @default(0)
  totalPrice    Float
  purchasePrice Float    @default(0)
  createdAt     DateTime @default(now())

  sale    Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])
  batch   ProductBatch @relation(fields: [batchId], references: [id])

  @@index([saleId])
}

model Payment {
  id            String   @id @default(uuid())
  shopId        String
  saleId        String?
  amount        Float
  paymentMethod String
  status        String   @default("SUCCESS")
  createdAt     DateTime @default(now())

  sale Sale? @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([saleId])
}

model Return {
  id                String   @id @default(uuid())
  shopId            String
  saleId            String
  receiptNumber     String
  returnedById      String
  totalRefundAmount Float
  reason            String?
  createdAt         DateTime @default(now())

  shop       Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sale       Sale         @relation(fields: [saleId], references: [id])
  returnedBy User         @relation(fields: [returnedById], references: [id])
  items      ReturnItem[]

  @@index([shopId])
  @@index([saleId])
}

model ReturnItem {
  id              String   @id @default(uuid())
  returnId        String
  saleItemId      String
  productId       String
  batchId         String
  quantity        Int
  refundUnitPrice Float
  totalRefund     Float
  createdAt       DateTime @default(now())

  returnObj Return       @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id])
  batch     ProductBatch @relation(fields: [batchId], references: [id])

  @@index([returnId])
}

model Notification {
  id           String   @id @default(uuid())
  shopId       String
  title        String
  message      String
  type         String // LOW_STOCK, EXPIRY_APPROACHING, EXPIRED, TRIAL_EXPIRING, SUB_EXPIRING, SUB_EXPIRED, SYSTEM
  referenceKey String?
  isRead       Boolean  @default(false)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, type, referenceKey])
  @@index([shopId])
  @@index([isRead])
  @@index([isDeleted])
  @@index([shopId, referenceKey])
}

model AuditLog {
  id        String   @id @default(uuid())
  shopId    String?
  userId    String?
  userName  String?
  action    String // MAHSULOT_QOSHILDI, SOTUV_QILINDI, etc.
  entity    String // Product, Sale, Shop, etc.
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([createdAt])
}
