# PostgreSQL ulanishi (production va development):
DATABASE_URL="postgresql://user:password@localhost:5432/savdoza?schema=public"

# Mahalliy PG kerak bo'lmasa: npm run db:start (embedded Postgres, .pgdata/)
# va DATABASE_URL="postgresql://postgres:postgres@localhost:5432/savdoza?schema=public"

# JWT maxfiy kaliti (production uchun kuchli tasodifiy qiymat ishlating)
JWT_SECRET=""  # majburiy, kamida 32 belgi: openssl rand -hex 32

# Dastur URL manzili
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mahsulot muddati yaqinlashganda ogohlantirish kunlari (default: 90)
EXPIRY_WARNING_DAYS="90"
NEXT_PUBLIC_EXPIRY_WARNING_DAYS="90"

# Boshlang'ich Super Admin (faqat seed uchun, production'da o'zgartiring)
INITIAL_SUPER_ADMIN_USERNAME="superadmin"
INITIAL_SUPER_ADMIN_PASSWORD=""  # production'da majburiy, kuchli parol yozing
INITIAL_SUPER_ADMIN_NAME="Bosh Administrator"

# Product Code Center Integratsiyasi
CENTRAL_CODE_CENTER_URL="http://localhost:3001"
CENTRAL_CODE_CENTER_API_KEY=""  # kalitni faqat serverdagi .env ga yozing, GitHub'ga yuklamang

# Tezcheck — server only
TEZCHECK_API_TOKEN=""
TEZCHECK_CASH_DESK_CODE=""
TEZCHECK_WEBHOOK_SECRET=""
APP_URL="https://your-domain.uz"
